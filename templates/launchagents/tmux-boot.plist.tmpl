<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__PREFIX__.tmux-boot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__AGENT_EXECUTABLE__</string>
		<string>run-background-task</string>
		<string>/bin/bash</string>
		<string>__ROOT__/loops/tmux-boot</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- The boot script resolves tmux before it runs either helper. -->
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/bin:__HOME__/.local/bin</string>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>TM_CONFIG_DIR</key>
		<string>__HOME__/.config/tmux-command-center</string>
	</dict>
	<!-- RunAtLoad only. This brings the server up once at login; it is not a
	     keepalive, because tmux is supposed to outlive it. KeepAlive here would
	     relaunch the boot script in a loop against a server already running. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/__PREFIX__.tmux-boot.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/__PREFIX__.tmux-boot.log</string>
</dict>
</plist>
