<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__PREFIX__.cost-watch</string>
	<!-- Launch through the signed/ad-hoc-signed Wideband app so macOS presents
	     one branded background item. Python is a verified absolute path. -->
	<key>ProgramArguments</key>
	<array>
		<string>__AGENT_EXECUTABLE__</string>
		<string>run-background-task</string>
		<string>__PYTHON__</string>
		<string>__ROOT__/loops/cost-watch</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- cost-watch resolves its imsg binary through Wideband's toolchain guard. -->
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/bin:__HOME__/.local/bin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/__PREFIX__.cost-watch.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/__PREFIX__.cost-watch.log</string>
</dict>
</plist>
