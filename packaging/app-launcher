#!/bin/bash
# Finder entry point for Wideband Setup.app.
set -uo pipefail
umask 077
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin"

CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
RESOURCES="$CONTENTS/Resources"
PAYLOAD="$RESOURCES/wb-setup"
AGENT_SOURCE="$RESOURCES/Wideband Agent.app"
ENGINE_SOURCE="$RESOURCES/wb-setup-engine"
SETUP_APP_SOURCE="$(cd "$CONTENTS/.." && pwd)"
SETUP_APP_TARGET="$HOME/Applications/Wideband Setup.app"
AGENT_TARGET="$HOME/Applications/Wideband Agent.app"
TARGET="$HOME/srv/wb-setup"
STATE="$HOME/.wideband/setup"
MARKER="$STATE/payload-build"
AGENT_MARKER="$STATE/agent-build"
AGENT_REVISION_MARKER="$STATE/agent-revision"
AGENT_CDHASH_MARKER="$STATE/agent-cdhash"
SETUP_APP_MARKER="$STATE/setup-app-build"
DEACTIVATED="$STATE/deactivated"
BUILD_ID="$(sed -n '1p' "$RESOURCES/build-id.txt" 2>/dev/null)"
AGENT_REVISION="$(sed -n '1p' "$RESOURCES/agent-revision.txt" 2>/dev/null)"
NATIVE_PID="${WB_SETUP_NATIVE_PID:-}"
NATIVE_ACTIVE=0
LAUNCH_STAGE="package resources"

fail() {
  /usr/bin/osascript - "$LAUNCH_STAGE" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display alert "Wideband Setup" message ("Setup stopped while preparing " & (item 1 of argv) & ". Reopen Wideband Setup to retry. If it stops again, contact Wideband with this stage name; setup may have saved a rollback copy.") as critical
end run
APPLESCRIPT
  exit 1
}

launch_terminal() {
  # Login restoration can leave Terminal briefly unavailable just after the
  # desktop appears. A client should not see a fatal installer alert for that
  # transient race, especially after an immediate or repeated double-click.
  local attempt=1
  ( umask 077; printf '%s\n' "$BUILD_ID" > "$STATE/terminal-hosted" ) || return 1
  while [ "$attempt" -le 5 ]; do
    /usr/bin/open -a Terminal "$TARGET/.wideband-setup.command" && return 0
    /bin/sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

core_ready() {
  [ -f "$HOME/.sop-vars" ] \
    && [ -f "$TARGET/lib/bootstrap-homebrew.sh" ] || return 1
  # shellcheck source=lib/bootstrap-homebrew.sh
  . "$TARGET/lib/bootstrap-homebrew.sh" || return 1
  wb_tc_resolve || return 1
  [ "$WB_TOOLCHAIN_KIND" = private ] || [ "$WB_TOOLCHAIN_KIND" = legacy_homebrew ]
}

connection_is_live() {
  [ -f "$STATE/connection.json" ] || return 1
  local pid port token build
  pid="$(/usr/bin/plutil -extract pid raw -o - "$STATE/connection.json" 2>/dev/null)" || return 1
  port="$(/usr/bin/plutil -extract port raw -o - "$STATE/connection.json" 2>/dev/null)" || return 1
  token="$(/usr/bin/plutil -extract token raw -o - "$STATE/connection.json" 2>/dev/null)" || return 1
  build="$(/usr/bin/plutil -extract build_id raw -o - "$STATE/connection.json" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$port" =~ ^[0-9]+$ ]] && [ -n "$token" ] \
    && [ "$build" = "$BUILD_ID" ] && /bin/kill -0 "$pid" 2>/dev/null \
    && /usr/bin/curl -fsS --max-time 1 -H "X-Wideband-Token: $token" \
      "http://127.0.0.1:$port/api/health" >/dev/null 2>&1
}

launch_background() {
  local engine_pid attempt
  /bin/rm -f "$STATE/terminal-hosted" 2>/dev/null || true
  ( umask 077; : > "$STATE/engine.log" ) || return 1
  /bin/chmod 600 "$STATE/engine.log" 2>/dev/null || return 1
  /usr/bin/nohup "$TARGET/.wideband-setup.command" --embedded \
    >> "$STATE/engine.log" 2>&1 &
  engine_pid=$!
  attempt=1
  while [ "$attempt" -le 40 ]; do
    connection_is_live && return 0
    /bin/kill -0 "$engine_pid" 2>/dev/null || return 1
    /bin/sleep 0.25
    attempt=$((attempt + 1))
  done
  return 0
}

[ -n "$BUILD_ID" ] && [[ "$AGENT_REVISION" =~ ^[0-9a-f]{64}$ ]] \
  && [ -f "$PAYLOAD/setup.py" ] && [ -d "$AGENT_SOURCE" ] \
  && [ -f "$RESOURCES/agent-revision.sh" ] \
  && [ -x "$ENGINE_SOURCE" ] || fail
[ -f "$PAYLOAD/lib/native-preflight.sh" ] || fail
if ! PREFLIGHT_RESULT="$(/bin/bash "$PAYLOAD/lib/native-preflight.sh" \
      "$SETUP_APP_SOURCE" "$PAYLOAD" "$BUILD_ID" 2>&1)"; then
  /usr/bin/osascript - "$PREFLIGHT_RESULT" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display alert "Wideband Setup preflight" message (item 1 of argv) as critical
end run
APPLESCRIPT
  exit 1
fi
. "$RESOURCES/agent-revision.sh" || fail
LAUNCH_STAGE="private install directories"
/bin/mkdir -p "$HOME/.wideband" "$TARGET" "$STATE" "$HOME/Applications" || fail
# Older Setup versions created the owned ~/.wideband parent with the login
# umask (usually 0755). Tighten it before the private toolchain validates the
# parent; preflight has already proved it belongs to this login and is not a
# symlink. Never change another account's Homebrew prefix.
/bin/chmod 700 "$HOME/.wideband" "$STATE" || fail

if [[ "$NATIVE_PID" =~ ^[0-9]+$ ]] && /bin/kill -0 "$NATIVE_PID" 2>/dev/null; then
  NATIVE_ACTIVE=1
  ( umask 077; printf '%s\n' "$NATIVE_PID" > "$STATE/native-shell-pid" ) || fail
else
  /bin/rm -f "$STATE/native-shell-pid" 2>/dev/null || true
fi

# Leave behind the exact verified setup app so a client who double-clicks it
# directly from the disk image can eject the image and still resume later.
SETUP_APP_INSTALLED="$(sed -n '1p' "$SETUP_APP_MARKER" 2>/dev/null)"
PREVIOUS_SETUP_APP="$SETUP_APP_TARGET"
PREVIOUS_PAYLOAD_BUILD="$(sed -n '1p' "$MARKER" 2>/dev/null)"
# A prior released package may keep using its own healthy Homebrew while the
# private toolchain is staged. A fresh installation never inherits that path.
case "$PREVIOUS_PAYLOAD_BUILD" in
  0.7.0-*|0.7.1-*)
    if [ "${PREVIOUS_PAYLOAD_BUILD%%-*}" != "${BUILD_ID%%-*}" ]; then
      LEGACY_MARKER="$STATE/legacy-homebrew-allowed"
      [ ! -L "$LEGACY_MARKER" ] || fail
      if [ -e "$LEGACY_MARKER" ]; then
        [ -f "$LEGACY_MARKER" ] \
          && [ "$(/usr/bin/stat -f '%u' "$LEGACY_MARKER" 2>/dev/null)" = "$(/usr/bin/id -u)" ] || fail
      fi
      ( umask 077; printf '%s\n' "$PREVIOUS_PAYLOAD_BUILD" > "$STATE/legacy-homebrew-allowed" ) || fail
      /bin/chmod 600 "$STATE/legacy-homebrew-allowed" || fail
    fi
    ;;
esac
SOURCE_IS_INSTALLED=0
LAUNCH_STAGE="the resumable Setup app"
case "$SETUP_APP_SOURCE" in
  /Applications/*|"$HOME/Applications/"*) SOURCE_IS_INSTALLED=1 ;;
esac
if [ "$SOURCE_IS_INSTALLED" != 1 ] \
   && [ "$SETUP_APP_SOURCE" != "$SETUP_APP_TARGET" ] \
   && { [ "$SETUP_APP_INSTALLED" != "$BUILD_ID" ] || [ ! -x "$SETUP_APP_TARGET/Contents/MacOS/Wideband Setup" ]; }; then
  if [ -e "$SETUP_APP_TARGET" ]; then
    SETUP_APP_BACKUP="$STATE/package-backups/$(date '+%Y%m%d-%H%M%S')-$$/Wideband Setup.app"
    /bin/mkdir -p "$(dirname "$SETUP_APP_BACKUP")" || fail
    /bin/mv "$SETUP_APP_TARGET" "$SETUP_APP_BACKUP" || fail
    PREVIOUS_SETUP_APP="$SETUP_APP_BACKUP"
  fi
  /usr/bin/ditto --norsrc --noextattr --noqtn "$SETUP_APP_SOURCE" "$SETUP_APP_TARGET" || fail
  ( umask 077; printf '%s\n' "$BUILD_ID" > "$SETUP_APP_MARKER" ) || fail
fi

# Install the exact app that requests and verifies macOS privacy grants. Keep
# replaced copies in the setup backup area so an interrupted update never
# destroys the previous helper or touches an unrelated application.
LAUNCH_STAGE="Wideband Agent"
wb_agent_valid "$AGENT_SOURCE" || fail
[ "$(wb_agent_revision "$AGENT_SOURCE" "$PAYLOAD" "$STATE")" = "$AGENT_REVISION" ] || fail
AGENT_INSTALLED="$(sed -n '1p' "$AGENT_MARKER" 2>/dev/null)"
previous_setup_agent_matches() {
  local prior_build embedded
  prior_build="$(sed -n '1p' "$PREVIOUS_SETUP_APP/Contents/Resources/build-id.txt" 2>/dev/null)"
  if [ "$prior_build" = "$AGENT_INSTALLED" ]; then
    embedded="$PREVIOUS_SETUP_APP/Contents/Resources/Wideband Agent.app"
    wb_agent_valid "$embedded" \
      && [ "$(wb_agent_cdhash "$embedded")" = "$INSTALLED_CDHASH" ]
  else
    # The client may have copied the new Setup.app over the old one before
    # opening it. The old payload and Agent markers still provide lineage;
    # their signed, normalized code must independently match the new revision.
    [ -z "$prior_build" ] || [ "$prior_build" = "$BUILD_ID" ]
  fi
}
AGENT_REUSE=0
if [ ! -f "$DEACTIVATED" ] && wb_agent_valid "$AGENT_TARGET"; then
  INSTALLED_CDHASH="$(wb_agent_cdhash "$AGENT_TARGET")"
  if [ -n "$INSTALLED_CDHASH" ] \
     && [ "$(sed -n '1p' "$AGENT_REVISION_MARKER" 2>/dev/null)" = "$AGENT_REVISION" ] \
     && [ "$(sed -n '1p' "$AGENT_CDHASH_MARKER" 2>/dev/null)" = "$INSTALLED_CDHASH" ]; then
    AGENT_REUSE=1
  elif [ -n "$INSTALLED_CDHASH" ] \
       && [ ! -f "$AGENT_REVISION_MARKER" ] \
       && [ -n "$AGENT_INSTALLED" ] \
       && [ "$AGENT_INSTALLED" = "$PREVIOUS_PAYLOAD_BUILD" ] \
       && [ "$AGENT_INSTALLED" = "$SETUP_APP_INSTALLED" ] \
       && previous_setup_agent_matches \
       && [ "$(wb_agent_revision "$AGENT_TARGET" "$TARGET" "$STATE" 2>/dev/null)" = "$AGENT_REVISION" ]; then
    # One-time migration from packages that only recorded the Setup build ID.
    AGENT_REUSE=1
    ( umask 077; printf '%s\n' "$AGENT_REVISION" > "$AGENT_REVISION_MARKER" ) || fail
    ( umask 077; printf '%s\n' "$INSTALLED_CDHASH" > "$AGENT_CDHASH_MARKER" ) || fail
  fi
fi
if [ ! -f "$DEACTIVATED" ] && [ "$AGENT_REUSE" != 1 ]; then
  if [ -e "$AGENT_TARGET" ]; then
    AGENT_BACKUP="$STATE/package-backups/$(date '+%Y%m%d-%H%M%S')-$$/Wideband Agent.app"
    /bin/mkdir -p "$(dirname "$AGENT_BACKUP")" || fail
    /bin/mv "$AGENT_TARGET" "$AGENT_BACKUP" || fail
  fi
  /usr/bin/ditto --norsrc --noextattr --noqtn "$AGENT_SOURCE" "$AGENT_TARGET" || fail
  wb_agent_valid "$AGENT_TARGET" || fail
  INSTALLED_CDHASH="$(wb_agent_cdhash "$AGENT_TARGET")"
  [ -n "$INSTALLED_CDHASH" ] || fail
  ( umask 077; printf '%s\n' "$AGENT_REVISION" > "$AGENT_REVISION_MARKER" ) || fail
  ( umask 077; printf '%s\n' "$INSTALLED_CDHASH" > "$AGENT_CDHASH_MARKER" ) || fail
  ( umask 077; printf '%s\n' "$BUILD_ID" > "$AGENT_MARKER" ) || fail
fi

# Every packaged launch uses the simple client experience by default. A
# personalized package also seeds the validated build identity once; an
# existing identity always wins so an upgrade cannot flatten a curated Mac.
LAUNCH_STAGE="client setup state"
( umask 077; printf '%s\n' "$BUILD_ID" > "$STATE/client-package" ) || fail
if [ -f "$RESOURCES/client-profile.env" ]; then
  if [ ! -f "$HOME/.sop-vars" ]; then
    /usr/bin/ditto --norsrc --noextattr --noqtn "$RESOURCES/client-profile.env" "$HOME/.sop-vars" || fail
    /bin/chmod 600 "$HOME/.sop-vars" || fail
  fi
  ( umask 077; printf '%s\n' "personalized" > "$STATE/client-package-kind" ) || fail
else
  ( umask 077; printf '%s\n' "generic" > "$STATE/client-package-kind" ) || fail
fi

if [ "$NATIVE_ACTIVE" != 1 ] && [ ! -f "$STATE/native-welcome-seen" ]; then
  if [ -f "$RESOURCES/client-profile.env" ]; then
    WELCOME_DETAIL="Your Wideband build profile is already loaded. The branded setup guide opens immediately and shows live progress while Terminal prepares this Mac."
  else
    WELCOME_DETAIL="This generic pilot asks for your personal phone number in one macOS dialog. The branded guide then helps you name your OS and agent, choose a first job, and shows live progress while Terminal prepares this Mac."
  fi
  /usr/bin/osascript - "$RESOURCES/AppIcon.icns" "$WELCOME_DETAIL" <<'APPLESCRIPT' >/dev/null 2>&1 || exit 0
on run argv
  display dialog (item 2 of argv) & return & return & "Leave Terminal open behind the setup window. If the guide asks for your Mac password, enter it in Terminal; no dots or characters will appear. Wideband never receives that password." with title "Wideband Setup" buttons {"Begin setup"} default button "Begin setup" with icon POSIX file (item 1 of argv)
end run
APPLESCRIPT
  ( umask 077; printf '%s\n' "$BUILD_ID" > "$STATE/native-welcome-seen" ) || fail
fi

INSTALLED="$(sed -n '1p' "$MARKER" 2>/dev/null)"
LAUNCH_STAGE="setup files"
if [ "$INSTALLED" != "$BUILD_ID" ]; then
  if [ -n "$(/usr/bin/find "$TARGET" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    BACKUP="$STATE/package-backups/$(date '+%Y%m%d-%H%M%S')-$$/wb-setup"
    /bin/mkdir -p "$(dirname "$BACKUP")" || fail
    /usr/bin/ditto --norsrc --noqtn "$TARGET" "$BACKUP" || fail
  fi
  /usr/bin/ditto --norsrc --noextattr --noqtn "$PAYLOAD" "$TARGET" || fail
  ( umask 077; printf '%s\n' "$BUILD_ID" > "$MARKER" ) || fail
fi

# The bundled tool payload is copied into a new version and verified before
# its mode-0600 active pointer is switched. A previous version remains on disk
# for rollback. This never writes to another user's Homebrew installation.
if [ -d "$PAYLOAD/vendor/toolchain" ]; then
  LAUNCH_STAGE="private tools"
  [ -f "$PAYLOAD/lib/install-toolchain.sh" ] || fail
  /bin/bash "$PAYLOAD/lib/install-toolchain.sh" "$PAYLOAD/vendor/toolchain" "$BUILD_ID" || fail
fi

/usr/bin/ditto --norsrc --noextattr --noqtn "$RESOURCES/run-setup.command" "$TARGET/.wideband-setup.command" || fail
LAUNCH_STAGE="local setup engine"
/usr/bin/ditto --norsrc --noextattr --noqtn "$ENGINE_SOURCE" "$TARGET/.wideband-setup-engine" || fail
/bin/chmod 700 "$TARGET/.wideband-setup.command" "$TARGET/.wideband-setup-engine" || fail

# A verified toolchain can host the private guide quietly behind the app.
# A Mac awaiting the private payload gets Terminal to display the exact
# preflight blocker while the native guide remains available.
LAUNCH_STAGE="private setup guide"
if connection_is_live; then
  # The guide can stay live after bootstrap exits at a canceled owner-phone
  # prompt. In that state a later app launch must reopen Terminal to resume
  # bootstrap, while an in-progress bootstrap must keep its single prompt.
  case "$(sed -n '1p' "$STATE/bootstrap-status" 2>/dev/null)" in
    needs_attention|needs_independent_toolchain|needs_homebrew_ownership)
      if ! core_ready; then launch_terminal || fail; fi
      ;;
  esac
elif core_ready; then
  launch_background || fail
else
  launch_terminal || fail
fi
exit 0
