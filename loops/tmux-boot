#!/bin/bash
# tmux-boot — bring the standing sessions up at login.
#
# Starts a headless tmux server so every session is alive and attachable from
# any device, without opening a GUI window. Nothing here creates a window you
# have to look at; the point is that SSH from the phone lands on a server that
# is already up.
#
# Order matters and the sleeps are not padding:
#
#   start-server sources tmux.conf → tpm → continuum, and continuum then
#   restores the last saved environment. Reconciling against the standard
#   before that finishes would create an empty session that shadows the one
#   continuum is about to restore. So: start, guarantee a baseline, wait for
#   the restore, and only then fill in what is still missing.
#
# `tm-standard apply` only CREATES. It never kills or moves a live session,
# which is what makes this safe to run at every login and safe to re-run by
# hand.
#
# HOME comes from launchd; the private resolver pins tmux to the active
# Wideband payload or an explicitly approved current-owner legacy prefix.
set -uo pipefail

export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/bin:$HOME/.local/bin"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
TMUX_BIN="$(/bin/bash "$HERE/lib/toolchain-path" tmux 2>/dev/null)" || TMUX_BIN=""
TM_STANDARD="$HOME/bin/tm-standard"
TM_MEMORY="$HOME/bin/tm-memory"

[ -n "$TMUX_BIN" ] && [ -x "$TMUX_BIN" ] \
  || { echo "tmux-boot: verified tmux is unavailable" >&2; exit 1; }
export PATH="${TMUX_BIN%/tmux}:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/bin:$HOME/.local/bin"

"$TMUX_BIN" start-server
sleep 1

# A baseline session for the phone to attach to, before anything else runs.
"$TMUX_BIN" has-session -t main 2>/dev/null || "$TMUX_BIN" new-session -d -s main

# Let continuum finish restoring before reconciling.
sleep 8

# The safety net for what continuum cannot cover: a wiped resurrect directory,
# a fresh install, or a new Mac.
if [ -x "$TM_STANDARD" ]; then
  "$TM_STANDARD" apply --quiet 2>/dev/null || true
else
  echo "tmux-boot: tm-standard not found — only 'main' was created" >&2
fi

# Publish each session's identity card path into its tmux environment, so a
# process started there later can find out what the session is for.
#
# This deliberately does not start agents and does not type into any pane. At
# login nobody is watching: an agent is a running cost, and keystrokes sent to
# a fleet no one is looking at are how a wrong instruction lands unobserved.
# Recovery into a live pane stays a human-initiated act (`tm-memory resume`).
[ -x "$TM_MEMORY" ] && "$TM_MEMORY" prime --quiet 2>/dev/null

"$TMUX_BIN" ls 2>/dev/null
